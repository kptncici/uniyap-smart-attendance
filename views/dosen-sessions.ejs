<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Sesi Kuliah - <%= subject.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

<nav class="bg-green-600 text-white px-6 py-4 flex justify-between">
  <h1 class="font-bold">👨‍🏫 <%= subject.name %> - Sesi</h1>
  <a href="/dashboard/dosen" class="text-white underline">⬅ Kembali</a>
</nav>

<div class="max-w-4xl mx-auto mt-6 bg-white p-6 rounded-xl shadow">

  <!-- Form Buat Sesi -->
  <form action="/dashboard/dosen/subject/<%= subject.code %>/sessions/create" method="POST" class="mb-6 flex gap-3">
    <input type="date" name="date" required class="border rounded px-3 py-2"/>
    <input type="text" name="room" placeholder="Ruangan" required class="border rounded px-3 py-2"/>
    <button class="bg-green-600 text-white px-4 rounded">+ Buat Sesi</button>
  </form>

  <h2 class="font-bold text-green-600 mb-3">Daftar Sesi</h2>

  <% if (sessions.length > 0) { %>
    <table class="w-full text-sm border">
      <thead class="bg-green-50">
        <tr>
          <th class="p-2">Tanggal</th>
          <th class="p-2">Ruangan</th>
          <th class="p-2">QR</th>
          <th class="p-2"></th>
        </tr>
      </thead>
      <tbody>
        <% sessions.forEach(s => { %>
        <tr class="border-b">
          <td class="p-2"><%= new Date(s.date).toLocaleDateString("id-ID") %></td>
          <td class="p-2"><%= s.room %></td>
          <td class="p-2">
            <a href="<%= s.qrCode %>" class="text-green-600 underline">Lihat QR</a>
          </td>
          <td class="p-2 text-right">
            <a href="/dashboard/dosen/session/<%= s.id %>/attendance" class="bg-blue-600 text-white px-3 py-1 rounded text-xs">👀 Lihat Absensi</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="text-gray-500 italic">Belum ada sesi dibuat.</p>
  <% } %>

</div>
</body>
</html>
