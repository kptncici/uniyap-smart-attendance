<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Scan QR</title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#f6fbf7] p-6 font-[Poppins]">

<a href="/dashboard/mahasiswa" class="bg-gray-200 px-4 py-2 rounded-lg shadow text-sm mb-4 inline-block">
  ⬅ Kembali
</a>

<div class="bg-white shadow p-6 rounded-xl max-w-md mx-auto text-center">
  <h2 class="text-xl font-bold text-[#0ea44d] mb-2">📷 Scan QR</h2>
  <p class="text-gray-600 mb-4 text-sm">Masukkan Kode Sesi dari QR</p>

  <form action="/dashboard/mahasiswa/scan" method="POST" class="space-y-4">
    <input type="text" name="sessionId" placeholder="Tempel Session ID dari QR"
      class="w-full border p-2 rounded-lg focus:ring-[#0ea44d] outline-none text-sm">

    <button class="w-full bg-[#0ea44d] hover:bg-[#0c8f44] text-white py-2 rounded-lg font-medium shadow">
      ✅ Absen Sekarang
    </button>
  </form>

  <p class="mt-3 text-xs text-gray-500">* Fitur Scan Kamera menyusul</p>
</div>

</body>
</html>
