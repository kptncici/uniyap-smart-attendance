<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Riwayat Absen</title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#f6fbf7] p-6 font-[Poppins]">

<!-- BACK BUTTON -->
<a href="/dashboard/mahasiswa" class="bg-gray-200 px-4 py-2 rounded-lg shadow text-sm mb-4 inline-block">
  ⬅ Kembali
</a>

<h2 class="text-2xl font-bold text-[#0ea44d] mb-4">Riwayat Presensi</h2>

<!-- ======================================= -->
<!-- 🎒 FILTER AREA -->
<!-- ======================================= -->
<div class="bg-white p-5 rounded-xl shadow mb-6 border">

  <h3 class="text-lg font-semibold text-green-700 mb-3">Filter</h3>

  <form method="GET" class="space-y-4">

    <!-- Tanggal mulai / akhir -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="text-sm text-gray-600">Tanggal Mulai</label>
        <input 
          type="date"
          name="startDate"
          value="<%= startDate || '' %>"
          class="border rounded-lg px-3 py-2 w-full"
        >
      </div>

      <div>
        <label class="text-sm text-gray-600">Tanggal Akhir</label>
        <input 
          type="date"
          name="endDate"
          value="<%= endDate || '' %>"
          class="border rounded-lg px-3 py-2 w-full"
        >
      </div>
    </div>

    <!-- Dropdown Mata Kuliah -->
    <div>
      <label class="text-sm text-gray-600">Mata Kuliah</label>
      <select 
        name="subjectCode" 
        class="border rounded-lg px-3 py-2 w-full"
      >
        <option value="all">Semua Mata Kuliah</option>

        <% subjects.forEach(s => { %>
          <option value="<%= s.code %>"
            <%= selectedSubject == s.code ? 'selected' : '' %>>
            <%= s.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Button -->
    <button 
      class="bg-green-600 hover:bg-green-700 text-white w-full py-2 rounded-lg font-semibold">
      Tampilkan
    </button>

  </form>
</div>

<!-- ======================================= -->
<!-- 📋 TABEL RIWAYAT -->
<!-- ======================================= -->
<div class="bg-white p-4 rounded-xl shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-[#e0f5e9] text-green-700">
      <tr>
        <th class="p-2 text-left">Mata Kuliah</th>
        <th class="p-2 text-left">Tanggal</th>
        <th class="p-2 text-left">Jam</th>
        <th class="p-2 text-left">Status</th>
      </tr>
    </thead>

    <tbody>
      <% if (!history.length) { %>
        <tr>
          <td colspan="4" class="text-center py-4 text-gray-500 italic">
            Belum ada data
          </td>
        </tr>
      <% } %>

      <% history.forEach(r => { %>
      <tr class="border-b hover:bg-gray-50">
        <td class="p-2"><%= r.subjectName %></td>
        <td class="p-2"><%= r.date.toISOString().split("T")[0] %></td>
        <td class="p-2"><%= r.attendanceTime.toLocaleTimeString() %></td>
        <td class="p-2 font-semibold <%= r.status === 'Hadir' ? 'text-green-600' : 'text-red-500' %>">
          <%= r.status %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

</body>
</html>
