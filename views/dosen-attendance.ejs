<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Absensi Sesi</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

<nav class="bg-green-600 text-white px-6 py-4 flex justify-between">
  <h1 class="font-bold">📋 Daftar Kehadiran</h1>
  <a href="/dashboard/dosen" class="text-white underline">⬅ Dashboard</a>
</nav>

<div class="max-w-4xl mx-auto mt-6 bg-white p-6 rounded-xl shadow">
  <h2 class="font-bold text-green-600 mb-3">
    Sesi tanggal: <%= new Date(session.date).toLocaleDateString("id-ID") %>
  </h2>

  <% if (attendance.length > 0) { %>
  <table class="w-full text-sm border">
    <thead class="bg-green-50">
      <tr>
        <th class="p-2">NIM</th>
        <th class="p-2">Nama</th>
        <th class="p-2">Status</th>
      </tr>
    </thead>
    <tbody>
      <% attendance.forEach(a => { %>
      <tr class="border-b">
        <td class="p-2"><%= a.studentNim %></td>
        <td class="p-2"><%= a.student?.name %></td>
        <td class="p-2 text-green-600 font-bold"><%= a.status %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
    <p class="text-gray-500 italic">Belum ada mahasiswa hadir.</p>
  <% } %>
</div>
</body>
</html>
