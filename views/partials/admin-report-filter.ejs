<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Laporan Kehadiran - Sistem Absensi QR UNIYAP</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-emerald-50 min-h-screen">
  <div class="max-w-6xl mx-auto py-10 px-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-3xl font-bold text-emerald-700 flex items-center gap-2">
        📅 Laporan Kehadiran
      </h2>

      <!-- Tombol Export Excel -->
      <form action="/dashboard/admin/report/export" method="GET" class="flex gap-2 items-center">
        <input type="hidden" name="startDate" value="<%= startDate || '' %>">
        <input type="hidden" name="endDate" value="<%= endDate || '' %>">
        <input type="hidden" name="lecturerNip" value="<%= lecturerNip || '' %>">
        <input type="hidden" name="subjectCode" value="<%= subjectCode || '' %>">
        <button
          class="bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium shadow hover:bg-emerald-700 transition-all">
          📊 Download Excel
        </button>
      </form>
    </div>

    <!-- 🔍 Filter Form -->
    <form method="GET" action="/dashboard/admin/report"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 bg-white p-6 rounded-xl shadow mb-8 border border-emerald-100">
      
      <!-- Tanggal Mulai -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tanggal Mulai</label>
        <input type="date" name="startDate" value="<%= startDate || '' %>"
               class="border border-emerald-300 focus:ring-emerald-400 focus:border-emerald-400 rounded px-3 py-1.5 w-full">
      </div>

      <!-- Tanggal Akhir -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tanggal Akhir</label>
        <input type="date" name="endDate" value="<%= endDate || '' %>"
               class="border border-emerald-300 focus:ring-emerald-400 focus:border-emerald-400 rounded px-3 py-1.5 w-full">
      </div>

      <!-- Dosen -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Dosen</label>
        <select name="lecturerNip"
                class="border border-emerald-300 focus:ring-emerald-400 focus:border-emerald-400 rounded px-3 py-1.5 w-full">
          <option value="">Semua</option>
          <% lecturers.forEach(l => { %>
            <option value="<%= l.nip %>" <%= lecturerNip === l.nip ? 'selected' : '' %>><%= l.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Mata Kuliah -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mata Kuliah</label>
        <select name="subjectCode"
                class="border border-emerald-300 focus:ring-emerald-400 focus:border-emerald-400 rounded px-3 py-1.5 w-full">
          <option value="">Semua</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.code %>" <%= subjectCode === s.code ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-span-1 md:col-span-2 lg:col-span-4 text-right mt-2">
        <button
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-5 py-2 rounded-lg shadow transition-all">
          🔍 Terapkan Filter
        </button>
      </div>
    </form>

    <!-- 📋 Tabel Kehadiran -->
    <% if (attendances && attendances.length > 0) { %>
      <div class="overflow-x-auto bg-white rounded-xl shadow border border-emerald-100">
        <table class="w-full text-sm">
          <thead class="bg-emerald-100 text-emerald-900 font-semibold">
            <tr>
              <th class="border p-3 text-left">Tanggal</th>
              <th class="border p-3 text-left">NIM</th>
              <th class="border p-3 text-left">Nama</th>
              <th class="border p-3 text-left">Mata Kuliah</th>
              <th class="border p-3 text-left">Dosen</th>
              <th class="border p-3 text-left">Status</th>
            </tr>
          </thead>
          <tbody>
            <% attendances.forEach(a => { %>
              <tr class="hover:bg-emerald-50 transition">
                <td class="border p-2"><%= new Date(a.date).toLocaleDateString("id-ID") %></td>
                <td class="border p-2"><%= a.studentNim %></td>
                <td class="border p-2"><%= a.student?.name || a.studentName %></td>
                <td class="border p-2"><%= a.subject?.name || a.subjectName %></td>
                <td class="border p-2"><%= a.lecturerName || '-' %></td>
                <td class="border p-2 font-medium <%= a.status === 'Hadir' ? 'text-emerald-600' : 'text-red-500' %>">
                  <%= a.status %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-center text-gray-500 italic mt-6">
        Tidak ada data kehadiran ditemukan untuk filter yang dipilih.
      </p>
    <% } %>
  </div>
</body>
</html>
