<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<title>QR Absensi</title>
<script src="/socket.io/socket.io.js"></script>
<link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-gray-100 flex flex-col items-center justify-center">

<h2 class="text-xl font-bold mb-3">QR Absensi — <%= session.subject.name %></h2>

<div id="qrBox" class="bg-white p-4 shadow rounded">
  <img id="qrImage" src="<%= session.qrCode %>" class="w-56 h-56" />
</div>

<p id="countdown" class="mt-2 text-sm text-gray-500"></p>

<div class="mt-4 text-xl font-semibold">
  👥 Hadir: <span id="count">0</span>
</div>

<script>
const socket = io();
let timeLeft = 15;

function tick() {
  document.getElementById("countdown").innerText =
    "QR akan berubah dalam " + timeLeft + " detik";
    
  timeLeft--;
  if (timeLeft < 0) timeLeft = 15;
}
setInterval(tick, 1000);

// ✅ Terima QR baru
socket.on("qrUpdated", (data) => {
  document.getElementById("qrImage").src = data.qr;
});

// ✅ Update jumlah hadir realtime
socket.on("attendanceUpdate", (data) => {
  document.getElementById("count").innerText = data.count;
});
</script>

</body>
</html>
