<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login Mahasiswa | Sistem Absensi UNIYAP</title>
<link rel="stylesheet" href="/css/output.css" />

<style>
body {
  background: #e8f8ee;
  font-family: "Poppins", sans-serif;
}
.login-card {
  background: #fff;
  padding: 26px;
  border-radius: 16px;
  width: 100%;
  max-width: 360px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.08);
}
.input-box {
  border: 1px solid #cde7d6;
  padding: 10px 12px;
  border-radius: 8px;
  width: 100%;
}
.btn-green {
  background: #0ea44d;
  color: #fff;
  padding: 10px;
  width: 100%;
  border-radius: 8px;
  font-weight: 600;
  transition: .2s;
}
.btn-green:hover {
  background: #0c8a43;
}
</style>
</head>

<body class="flex justify-center items-center min-h-screen">

<div class="login-card text-center">

  <img src="/img/logo_kampus.png" class="w-16 mx-auto mb-3">

  <h1 class="text-xl font-semibold text-green-700 mb-6">Login Mahasiswa</h1>

  <!-- ✅ LOGIN MAHASISWA TANPA PASSWORD -->
  <form action="/auth/login-mahasiswa" method="POST">

    <div class="text-left mb-4">
      <label class="text-sm font-medium">NPM</label>
      <input 
        type="text" 
        name="nim" 
        class="input-box" 
        placeholder="2021xxxxx" 
        required>
    </div>

    <button class="btn-green w-full">Masuk</button>
  </form>

  <a href="/" class="block mt-4 text-sm text-green-700 hover:underline">
    ← Kembali ke Portal
  </a>
</div>

</body>
</html>
