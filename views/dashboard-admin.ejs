<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>
    <%= setting?.systemName || 'Sistem Absensi QR UNIYAP' %>
    - Admin Dashboard
  </title>

  <link rel="stylesheet" href="/css/output.css"/>

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    body{
      font-family:'Poppins',sans-serif;
      transition:.3s;
    }

    header{
      background:#00b14f;
      color:white;
      padding:.9rem 1.5rem;
      display:flex;
      justify-content:space-between;
      align-items:center;
      box-shadow:0 3px 12px rgba(0,0,0,.1);
    }

    header h1{
      font-size:1.25rem;
      font-weight:600;
      display:flex;
      align-items:center;
      gap:10px;
    }

    header img{
      height:38px;
      border-radius:8px;
    }

    .sidebar{
      width:250px;
      border-radius:18px;
      box-shadow:0 6px 20px rgba(0,0,0,.08);
      padding:1.25rem;
      height:fit-content;
      position:sticky;
      top:20px;
    }

    .sidebar a{
      display:flex;
      align-items:center;
      gap:10px;
      padding:.75rem 1rem;
      border-radius:10px;
      font-weight:500;
      transition:.25s;
    }

    .sidebar a:hover,
    .sidebar a.active{
      background:#e6f8ec;
      color:#00b14f;
      transform:translateX(3px);
    }

    .content-box{
      border-radius:18px;
      box-shadow:0 6px 25px rgba(0,0,0,.05);
      padding:2rem;
    }

    footer{
      text-align:center;
      padding:1rem;
      font-size:.9rem;
      margin-top:2rem;
    }

    #notif{
      position:fixed;
      top:20px;
      right:20px;
      background:#00b14f;
      color:white;
      padding:10px 16px;
      border-radius:8px;
      font-weight:500;
      box-shadow:0 4px 12px rgba(0,0,0,.2);
      opacity:0;
      transform:translateY(-20px);
      transition:.3s;
      z-index:9999;
    }

    #notif.show{
      opacity:1;
      transform:translateY(0);
    }

    @media(max-width:1024px){

      main{
        flex-direction:column;
      }

      .sidebar{
        width:100%;
        display:flex;
        flex-wrap:wrap;
        gap:10px;
      }

    }

  </style>

</head>

<body
  class="flex flex-col min-h-screen <%= setting?.darkMode ? 'bg-slate-900 text-slate-200' : 'bg-[#f1f8f4] text-slate-800' %>"
>

  <!-- HEADER -->
  <header>

    <h1>

      <% if(setting?.systemLogo){ %>

        <img
          id="adminLogo"
          src="<%= setting?.systemLogo || '/img/logo_kampus.png' %>"
          alt="Logo"
          loading="eager"
          draggable="false"
          onerror="this.style.display='none'"
          class="w-10 h-10 object-contain"
        />

      <% } %>

      <span id="adminTitle">
        <%= setting?.systemName || 'Sistem Absensi QR UNIYAP' %>
      </span>

    </h1>

    <div class="flex items-center gap-4">

      <span class="font-medium">
        <%= user.name || 'Administrator' %>
        (<%= user.role %>)
      </span>

      <a
        href="/auth/logout"
        class="bg-white text-[#00b14f] px-4 py-2 rounded-lg font-semibold shadow hover:scale-[1.03] transition"
      >
        Logout
      </a>

    </div>

  </header>

  <!-- MAIN -->
  <main class="flex flex-1 gap-8 p-8">

    <!-- SIDEBAR -->
    <aside
      class="sidebar <%= setting?.darkMode ? 'bg-slate-800' : 'bg-white' %>"
    >

      <a href="?tab=dosen"
         class="<%= tab === 'dosen' ? 'active' : '' %>">
        🏫 Data Dosen
      </a>

      <a href="?tab=mahasiswa"
         class="<%= tab === 'mahasiswa' ? 'active' : '' %>">
        🎓 Data Mahasiswa
      </a>

      <a href="?tab=matkul"
         class="<%= tab === 'matkul' ? 'active' : '' %>">
        📘 Mata Kuliah
      </a>

      <a href="?tab=grafik"
         class="<%= tab === 'grafik' ? 'active' : '' %>">
        📊 Statistik
      </a>

      <a href="?tab=settings"
         class="<%= tab === 'settings' ? 'active' : '' %>">
        ⚙️ Pengaturan
      </a>

      <a href="?tab=report"
         class="<%= tab === 'report' ? 'active' : '' %>">
        📅 Laporan
      </a>

    </aside>

    <!-- CONTENT -->
    <section
      class="flex-1 content-box <%= setting?.darkMode ? 'bg-slate-800' : 'bg-white' %>"
    >

      <% if(tab === 'dosen'){ %>

        <%- include('partials/admin-dosen',{
          lecturers
        }) %>

      <% } else if(tab === 'mahasiswa'){ %>

        <%- include('partials/admin-mahasiswa',{
          students
        }) %>

      <% } else if(tab === 'matkul'){ %>

        <%- include('partials/admin-matkul',{
          subjects
        }) %>

      <% } else if(tab === 'grafik'){ %>

        <%- include('partials/admin-grafik',{
          stats
        }) %>

      <% } else if(tab === 'settings'){ %>

        <%- include('partials/admin-settings',{
          setting,
          user
        }) %>

      <% } else if(tab === 'report'){ %>

        <%- include('partials/admin-report',{

          attendances:
            typeof attendances !== 'undefined'
              ? attendances
              : [],

          start:
            typeof start !== 'undefined'
              ? start
              : '',

          end:
            typeof end !== 'undefined'
              ? end
              : '',

          search:
            typeof search !== 'undefined'
              ? search
              : '',

          success:
            typeof success !== 'undefined'
              ? success
              : '',

          error:
            typeof error !== 'undefined'
              ? error
              : ''

        }) %>

      <% } else { %>

        <p class="text-center text-gray-500 italic py-10">
          Pilih menu di sidebar untuk melihat data.
        </p>

      <% } %>

    </section>

  </main>

  <!-- FOOTER -->
  <footer
    class="<%= setting?.darkMode ? 'text-slate-400' : 'text-slate-500' %>"
  >

    © <%= new Date().getFullYear() %>

    <span id="footerSystemName">
      <%= setting?.systemName || 'Sistem Absensi QR UNIYAP' %>
    </span>

    · Universitas Yapis Papua

  </footer>

  <!-- FLASH -->
  <% if(typeof success !== 'undefined' && success){ %>

    <div
      class="fixed top-5 right-5 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-[999]"
    >
      ✅ <%= decodeURIComponent(success) %>
    </div>

  <% } %>

  <% if(typeof error !== 'undefined' && error){ %>

    <div
      class="fixed top-5 right-5 bg-red-500 text-white px-4 py-2 rounded-lg shadow-lg z-[999]"
    >
      ❌ <%= decodeURIComponent(error) %>
    </div>

  <% } %>

  <!-- SOCKET -->
  <div id="notif"></div>

  <script src="/socket.io/socket.io.js"></script>

  <script>

    const socket = io();

    function showNotif(text){

      const box =
        document.getElementById("notif");

      box.innerText = text;

      box.classList.add("show");

      setTimeout(() => {

        box.classList.remove("show");

      },2500);

    }

    socket.on("settingUpdated",(data)=>{

      if(data.systemLogo){

        const logo =
          document.getElementById("adminLogo");

        if(logo)
          logo.src = data.systemLogo;

      }

      if(data.systemName){

        document.getElementById(
          "adminTitle"
        ).innerText = data.systemName;

        document.getElementById(
          "footerSystemName"
        ).innerText = data.systemName;

      }

      showNotif(
        "✅ Pengaturan sistem diperbarui!"
      );

    });

    // auto remove flash
    setTimeout(()=>{

      document
        .querySelectorAll(".fixed.top-5.right-5")
        .forEach(el=>el.remove());

    },3000);

  </script>

</body>
</html>
